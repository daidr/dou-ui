{
  "name": "@dou-ui/chart",
  "version": "0.1.0-alpha.8",
  "description": "DouUI 的图表：折线、面积、柱状、散点与饼图",
  "keywords": [
    "vue",
    "vue3",
    "chart",
    "canvas",
    "data-visualization",
    "graph"
  ],
  "license": "MIT",
  "author": "daidr <daidr@daidr.me>",
  "homepage": "https://github.com/daidr/dou-ui#readme",
  "bugs": "https://github.com/daidr/dou-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daidr/dou-ui.git",
    "directory": "packages/chart"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/style.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style": {
      "types": "./dist/style.d.ts",
      "import": "./dist/style.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && bun scripts/build-style.ts"
  },
  "peerDependencies": {
    "dou-ui": "workspace:*",
    "vue": "^3.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
