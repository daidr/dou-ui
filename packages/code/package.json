{
  "name": "@dou-ui/code",
  "version": "0.1.0-alpha.4",
  "description": "DouUI 的代码编辑器：大文件流畅编辑、输入法友好、多光标与协同",
  "keywords": [
    "vue",
    "vue3",
    "code-editor",
    "editor",
    "code",
    "textarea",
    "collaboration"
  ],
  "license": "MIT",
  "author": "daidr <daidr@daidr.me>",
  "homepage": "https://github.com/daidr/dou-ui#readme",
  "bugs": "https://github.com/daidr/dou-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daidr/dou-ui.git",
    "directory": "packages/code"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/style.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./collaboration": {
      "types": "./dist/types/collaboration/index.d.ts",
      "import": "./dist/collaboration/index.js"
    },
    "./lsp": {
      "types": "./dist/types/lsp/index.d.ts",
      "import": "./dist/lsp/index.js"
    },
    "./shiki": {
      "types": "./dist/types/shiki/index.d.ts",
      "import": "./dist/shiki/index.js"
    },
    "./worker": {
      "types": "./dist/types/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    },
    "./style": {
      "types": "./dist/style.d.ts",
      "import": "./dist/style.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && bun scripts/build-style.ts"
  },
  "dependencies": {
    "@dou-ui/icons": "workspace:*"
  },
  "peerDependencies": {
    "dou-ui": "workspace:*",
    "vue": "^3.5.0",
    "yjs": "^13.6.0",
    "shiki": "^1.0.0 || ^2.0.0 || ^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "yjs": {
      "optional": true
    },
    "shiki": {
      "optional": true
    }
  },
  "devDependencies": {
    "yjs": "^13.6.33",
    "y-protocols": "^1.0.7",
    "shiki": "2.5.0"
  }
}
