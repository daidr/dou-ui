{
  "name": "@dou-ui/code",
  "version": "0.0.0",
  "description": "DouUI 的代码编辑器：大文件流畅编辑、输入法友好、多光标与协同",
  "keywords": [
    "vue",
    "vue3",
    "code-editor",
    "editor",
    "code",
    "textarea"
  ],
  "license": "MIT",
  "author": "daidr <daidr@daidr.me>",
  "homepage": "https://github.com/daidr/dou-ui#readme",
  "bugs": "https://github.com/daidr/dou-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daidr/dou-ui.git",
    "directory": "packages/code"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && bun scripts/build-style.ts"
  },
  "peerDependencies": {
    "dou-ui": "workspace:*",
    "vue": "^3.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
