{
  "name": "@dou-ui/dashboard",
  "version": "0.1.0-alpha.9",
  "description": "DouUI 的仪表盘：可拖动、可缩放的网格布局与仪表盘设计器",
  "keywords": [
    "vue",
    "vue3",
    "dashboard",
    "grid-layout",
    "drag-and-drop",
    "resizable",
    "collaboration"
  ],
  "license": "MIT",
  "author": "daidr <daidr@daidr.me>",
  "homepage": "https://github.com/daidr/dou-ui#readme",
  "bugs": "https://github.com/daidr/dou-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daidr/dou-ui.git",
    "directory": "packages/dashboard"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/style.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./layout": {
      "types": "./dist/types/layout/index.d.ts",
      "import": "./dist/layout/index.js"
    },
    "./widgets": {
      "types": "./dist/types/widgets/index.d.ts",
      "import": "./dist/widgets/index.js"
    },
    "./chart": {
      "types": "./dist/types/chart/index.d.ts",
      "import": "./dist/chart/index.js"
    },
    "./pivot": {
      "types": "./dist/types/pivot/index.d.ts",
      "import": "./dist/pivot/index.js"
    },
    "./collaboration": {
      "types": "./dist/types/collaboration/index.d.ts",
      "import": "./dist/collaboration/index.js"
    },
    "./style": {
      "types": "./dist/style.d.ts",
      "import": "./dist/style.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && bun scripts/build-style.ts"
  },
  "peerDependencies": {
    "@dou-ui/chart": "workspace:*",
    "@dou-ui/pivot": "workspace:*",
    "dou-ui": "workspace:*",
    "vue": "^3.5.0",
    "yjs": "^13.6.0"
  },
  "peerDependenciesMeta": {
    "@dou-ui/chart": {
      "optional": true
    },
    "@dou-ui/pivot": {
      "optional": true
    },
    "yjs": {
      "optional": true
    }
  },
  "dependencies": {
    "@dou-ui/icons": "workspace:*",
    "@dou-ui/sheet": "workspace:*"
  },
  "devDependencies": {
    "@dou-ui/chart": "workspace:*",
    "@dou-ui/pivot": "workspace:*",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "publishConfig": {
    "access": "public"
  }
}
