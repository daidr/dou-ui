{
  "name": "dou-ui",
  "version": "0.1.0-alpha.14",
  "description": "为自己打造的 Vue 3 组件库：简洁克制，样式与组件分离，内置无障碍支持",
  "keywords": [
    "vue",
    "vue3",
    "components",
    "component-library",
    "ui",
    "design-tokens"
  ],
  "license": "MIT",
  "author": "daidr <daidr@daidr.me>",
  "homepage": "https://github.com/daidr/dou-ui#readme",
  "bugs": "https://github.com/daidr/dou-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daidr/dou-ui.git",
    "directory": "packages/dou-ui"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/components/*/style.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./components/*/style": {
      "types": "./dist/components/*/style.d.ts",
      "import": "./dist/components/*/style.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && bun scripts/copy-style.ts && bun scripts/write-style.ts"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@dou-ui/icons": "workspace:*",
    "@dou-ui/theme": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
