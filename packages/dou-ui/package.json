{
  "name": "dou-ui",
  "version": "0.0.0",
  "description": "A Vue 3 component library",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/components/*/style.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./components/*/style": "./dist/components/*/style.js",
    "./*": "./*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && bun scripts/copy-style.ts && bun scripts/write-style.ts"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@dou-ui/icons": "workspace:*",
    "@dou-ui/theme": "workspace:*"
  }
}
