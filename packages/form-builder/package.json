{
  "name": "@dou-ui/form-builder",
  "version": "0.1.0-alpha.15",
  "description": "DouUI 的表单设计器：用一份 JSON 描述搭建、渲染和校验表单",
  "keywords": [
    "vue",
    "vue3",
    "form",
    "form-builder",
    "schema",
    "low-code"
  ],
  "license": "MIT",
  "author": "daidr <daidr@daidr.me>",
  "homepage": "https://github.com/daidr/dou-ui#readme",
  "bugs": "https://github.com/daidr/dou-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daidr/dou-ui.git",
    "directory": "packages/form-builder"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/style.js",
    "./dist/*/style.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./renderer": {
      "types": "./dist/types/renderer/index.d.ts",
      "import": "./dist/renderer/index.js"
    },
    "./renderer/style": {
      "types": "./dist/renderer/style.d.ts",
      "import": "./dist/renderer/style.js"
    },
    "./collaboration": {
      "types": "./dist/types/collaboration/index.d.ts",
      "import": "./dist/collaboration/index.js"
    },
    "./code": {
      "types": "./dist/types/code/index.d.ts",
      "import": "./dist/code/index.js"
    },
    "./style": {
      "types": "./dist/style.d.ts",
      "import": "./dist/style.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && bun scripts/build-style.ts"
  },
  "peerDependencies": {
    "@dou-ui/code": "workspace:*",
    "dou-ui": "workspace:*",
    "vue": "^3.5.0",
    "yjs": "^13.6.0"
  },
  "peerDependenciesMeta": {
    "@dou-ui/code": {
      "optional": true
    },
    "yjs": {
      "optional": true
    }
  },
  "dependencies": {
    "@dou-ui/icons": "workspace:*"
  },
  "devDependencies": {
    "@dou-ui/code": "workspace:*",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "publishConfig": {
    "access": "public"
  }
}
