{
  "name": "@dou-ui/gantt",
  "version": "0.0.0",
  "description": "DouUI 的甘特图：任务排期、依赖与工作日历",
  "keywords": [
    "vue",
    "vue3",
    "gantt",
    "schedule",
    "timeline",
    "project"
  ],
  "license": "MIT",
  "author": "daidr <daidr@daidr.me>",
  "homepage": "https://github.com/daidr/dou-ui#readme",
  "bugs": "https://github.com/daidr/dou-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daidr/dou-ui.git",
    "directory": "packages/gantt"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/style.js",
    "./dist/*/style.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./collaboration": {
      "types": "./dist/types/collaboration/index.d.ts",
      "import": "./dist/collaboration/index.js"
    },
    "./scheduler": {
      "types": "./dist/types/scheduler/index.d.ts",
      "import": "./dist/scheduler/index.js"
    },
    "./scheduler/style": {
      "types": "./dist/scheduler/style.d.ts",
      "import": "./dist/scheduler/style.js"
    },
    "./style": {
      "types": "./dist/style.d.ts",
      "import": "./dist/style.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && bun scripts/build-style.ts"
  },
  "peerDependencies": {
    "dou-ui": "workspace:*",
    "vue": "^3.5.0",
    "yjs": "^13.6.0"
  },
  "peerDependenciesMeta": {
    "yjs": {
      "optional": true
    }
  },
  "dependencies": {
    "@dou-ui/icons": "workspace:*"
  },
  "devDependencies": {
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "publishConfig": {
    "access": "public"
  }
}
