{
  "name": "dou-icons",
  "version": "0.0.0",
  "description": "A line icon set for Vue 3, drawn for DouUI",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta": {
      "types": "./dist/types/meta.d.ts",
      "import": "./dist/meta.js"
    },
    "./svg/*": "./dist/svg/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen": "bun scripts/gen.ts",
    "build": "bun scripts/gen.ts && vite build && vue-tsc -p tsconfig.build.json && bun scripts/copy-svg.ts"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
