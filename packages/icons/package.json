{
  "name": "@dou-ui/icons",
  "version": "0.1.0-alpha.9",
  "description": "为 DouUI 绘制的 Vue 3 线性图标库，也可以单独使用",
  "keywords": [
    "vue",
    "vue3",
    "icons",
    "svg"
  ],
  "license": "MIT",
  "author": "daidr <daidr@daidr.me>",
  "homepage": "https://github.com/daidr/dou-ui#readme",
  "bugs": "https://github.com/daidr/dou-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daidr/dou-ui.git",
    "directory": "packages/icons"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta": {
      "types": "./dist/types/meta.d.ts",
      "import": "./dist/meta.js"
    },
    "./svg/*": "./dist/svg/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen": "bun scripts/gen.ts",
    "build": "bun scripts/gen.ts && vite build && vue-tsc -p tsconfig.build.json && bun scripts/copy-svg.ts",
    "review": "bun scripts/review.ts"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
