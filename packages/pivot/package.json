{
  "name": "@dou-ui/pivot",
  "version": "0.1.0-alpha.13",
  "description": "DouUI 的数据透视表：按行列维度分组汇总明细数据",
  "keywords": [
    "vue",
    "vue3",
    "pivot",
    "pivot-table",
    "crosstab",
    "aggregation"
  ],
  "license": "MIT",
  "author": "daidr <daidr@daidr.me>",
  "homepage": "https://github.com/daidr/dou-ui#readme",
  "bugs": "https://github.com/daidr/dou-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daidr/dou-ui.git",
    "directory": "packages/pivot"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/style.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/types/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    },
    "./worker": {
      "types": "./dist/types/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    },
    "./style": {
      "types": "./dist/style.d.ts",
      "import": "./dist/style.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && bun scripts/build-style.ts"
  },
  "peerDependencies": {
    "dou-ui": "workspace:*",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@dou-ui/icons": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
