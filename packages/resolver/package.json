{
  "name": "@dou-ui/resolver",
  "version": "0.0.0",
  "description": "Resolve DouUI components, directives and functions for on-demand auto-import",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen": "bun scripts/gen.ts",
    "build": "bun scripts/build.ts"
  }
}
