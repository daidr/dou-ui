{
  "name": "@dou-ui/theme",
  "version": "0.1.0-alpha.5",
  "description": "DouUI 的设计 Token、主题 API 与样式",
  "keywords": [
    "vue",
    "design-tokens",
    "css",
    "theme"
  ],
  "license": "MIT",
  "author": "daidr <daidr@daidr.me>",
  "homepage": "https://github.com/daidr/dou-ui#readme",
  "bugs": "https://github.com/daidr/dou-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daidr/dou-ui.git",
    "directory": "packages/theme"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./index.css": "./dist/index.css",
    "./core.css": "./dist/core.css",
    "./tokens.css": "./dist/tokens.css",
    "./components/*.css": "./dist/components/*.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen": "bun scripts/gen.ts",
    "build": "bun scripts/build.ts"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  }
}
