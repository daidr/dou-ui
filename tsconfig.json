{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "types": ["bun", "vite/client"],
    "paths": {
      "dou-ui": ["./packages/dou-ui/src/index.ts"],
      "@dou-ui/theme": ["./packages/theme/src/index.ts"],
      "@dou-ui/icons": ["./packages/icons/src/index.ts"],
      "@dou-ui/icons/meta": ["./packages/icons/src/meta.ts"],
      "@dou-ui/editor": ["./packages/editor/src/index.ts"],
      "@dou-ui/editor/collaboration": ["./packages/editor/src/collaboration/index.ts"],
      "@dou-ui/editor/code": ["./packages/editor/src/code/index.ts"],
      "@dou-ui/editor/flow": ["./packages/editor/src/flow/index.ts"],
      "@dou-ui/editor/markdown": ["./packages/editor/src/markdown/index.ts"],
      "@dou-ui/flow": ["./packages/flow/src/index.ts"],
      "@dou-ui/flow/collaboration": ["./packages/flow/src/collaboration/index.ts"],
      "@dou-ui/flow/whiteboard": ["./packages/flow/src/whiteboard/index.ts"],
      "@dou-ui/chart": ["./packages/chart/src/index.ts"],
      "@dou-ui/gantt": ["./packages/gantt/src/index.ts"],
      "@dou-ui/gantt/collaboration": ["./packages/gantt/src/collaboration/index.ts"],
      "@dou-ui/gantt/scheduler": ["./packages/gantt/src/scheduler/index.ts"],
      "@dou-ui/sheet": ["./packages/sheet/src/index.ts"],
      "@dou-ui/sheet/formula": ["./packages/sheet/src/formula/index.ts"],
      "@dou-ui/sheet/core": ["./packages/sheet/src/core/index.ts"],
      "@dou-ui/sheet/collaboration": ["./packages/sheet/src/collaboration/index.ts"],
      "@dou-ui/sheet/code": ["./packages/sheet/src/code/index.ts"],
      "@dou-ui/sheet-xlsx": ["./packages/sheet-xlsx/src/index.ts"],
      "@dou-ui/code": ["./packages/code/src/index.ts"],
      "@dou-ui/code/worker": ["./packages/code/src/worker/index.ts"],
      "@dou-ui/code/collaboration": ["./packages/code/src/collaboration/index.ts"],
      "@dou-ui/code/shiki": ["./packages/code/src/shiki/index.ts"],
      "@dou-ui/code/lsp": ["./packages/code/src/lsp/index.ts"],
      "@dou-ui/dashboard": ["./packages/dashboard/src/index.ts"],
      "@dou-ui/dashboard/layout": ["./packages/dashboard/src/layout/index.ts"],
      "@dou-ui/dashboard/widgets": ["./packages/dashboard/src/widgets/index.ts"],
      "@dou-ui/dashboard/chart": ["./packages/dashboard/src/chart/index.ts"],
      "@dou-ui/dashboard/pivot": ["./packages/dashboard/src/pivot/index.ts"],
      "@dou-ui/dashboard/collaboration": ["./packages/dashboard/src/collaboration/index.ts"],
      "@dou-ui/pivot": ["./packages/pivot/src/index.ts"],
      "@dou-ui/pivot/engine": ["./packages/pivot/src/engine/index.ts"],
      "@dou-ui/pivot/worker": ["./packages/pivot/src/worker/index.ts"],
      "@dou-ui/form-builder": ["./packages/form-builder/src/index.ts"],
      "@dou-ui/form-builder/renderer": ["./packages/form-builder/src/renderer/index.ts"],
      "@dou-ui/form-builder/collaboration": ["./packages/form-builder/src/collaboration/index.ts"],
      "@dou-ui/form-builder/code": ["./packages/form-builder/src/code/index.ts"],
      "@dou-ui/resolver": ["./packages/resolver/src/index.ts"]
    }
  },
  "vueCompilerOptions": {
    "checkUnknownProps": true,
    "checkUnknownEvents": true
  },
  "include": [
    "types",
    "test",
    "scripts",
    "packages/*/src",
    "packages/*/scripts",
    "packages/*/vite.config.ts",
    "playground/src",
    "playground/vite.config.ts",
    "bench/src",
    "bench/vite.config.ts",
    "docs/.vitepress",
    "docs/examples",
    "vitest.config.ts"
  ]
}
