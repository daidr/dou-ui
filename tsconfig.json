{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun", "vite/client"],
    "paths": {
      "dou-ui": ["./packages/dou-ui/src/index.ts"],
      "@dou-ui/theme": ["./packages/theme/src/index.ts"],
      "@dou-ui/icons": ["./packages/icons/src/index.ts"],
      "@dou-ui/icons/meta": ["./packages/icons/src/meta.ts"],
      "@dou-ui/editor": ["./packages/editor/src/index.ts"],
      "@dou-ui/editor/collaboration": ["./packages/editor/src/collaboration/index.ts"],
      "@dou-ui/resolver": ["./packages/resolver/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/scripts",
    "packages/*/vite.config.ts",
    "playground/src",
    "playground/vite.config.ts",
    "bench/src",
    "bench/vite.config.ts",
    "docs/.vitepress",
    "vitest.config.ts"
  ]
}
