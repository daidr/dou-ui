{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun", "vite/client"],
    "paths": {
      "dou-ui": ["./packages/dou-ui/src/index.ts"],
      "@dou-ui/theme": ["./packages/theme/src/index.ts"],
      "@dou-ui/icons": ["./packages/icons/src/index.ts"],
      "@dou-ui/icons/meta": ["./packages/icons/src/meta.ts"],
      "@dou-ui/editor": ["./packages/editor/src/index.ts"],
      "@dou-ui/editor/collaboration": ["./packages/editor/src/collaboration/index.ts"],
      "@dou-ui/flow": ["./packages/flow/src/index.ts"],
      "@dou-ui/chart": ["./packages/chart/src/index.ts"],
      "@dou-ui/gantt": ["./packages/gantt/src/index.ts"],
      "@dou-ui/gantt/collaboration": ["./packages/gantt/src/collaboration/index.ts"],
      "@dou-ui/gantt/scheduler": ["./packages/gantt/src/scheduler/index.ts"],
      "@dou-ui/sheet": ["./packages/sheet/src/index.ts"],
      "@dou-ui/code": ["./packages/code/src/index.ts"],
      "@dou-ui/pivot": ["./packages/pivot/src/index.ts"],
      "@dou-ui/pivot/engine": ["./packages/pivot/src/engine/index.ts"],
      "@dou-ui/form-builder": ["./packages/form-builder/src/index.ts"],
      "@dou-ui/form-builder/renderer": ["./packages/form-builder/src/renderer/index.ts"],
      "@dou-ui/resolver": ["./packages/resolver/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/scripts",
    "packages/*/vite.config.ts",
    "playground/src",
    "playground/vite.config.ts",
    "bench/src",
    "bench/vite.config.ts",
    "docs/.vitepress",
    "vitest.config.ts"
  ]
}
